Deno.test("Numerics.BigUint128.rotateLeft() - error", () => {
  assertThrows(
    () => {
      testRL(-1n, 0);
    },
    TypeError,
    "Input must be a 128-bit unsigned integer of type `bigint`",
  );
  assertThrows(
    () => {
      testRL(0x100000000000000000000000000000000n, 0);
    },
    TypeError,
    "Input must be a 128-bit unsigned integer of type `bigint`",
  );

  assertThrows(
    () => {
      testRL(0n, 0.5);
    },
    TypeError,
    "Offset must be a safe-integer of type `number`",
  );
});
