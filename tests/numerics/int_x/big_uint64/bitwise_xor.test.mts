import { assertStrictEquals, assertThrows } from "@std/assert";
import { Numerics } from "../../../../src/mod.mts";

function testXOr(a: bigint, b: bigint) {
  return Numerics.BigUint64.bitwiseXOr(a, b);
}

Deno.test("Numerics.BigUint64.bitwiseXOr()", () => {
  assertStrictEquals(testXOr(0b0000_00n, 0b0000_00n), 0b0000_00n);
  assertStrictEquals(testXOr(0b1111_11n, 0b1111_11n), 0b0000_00n);
  assertStrictEquals(testXOr(0b0000_00n, 0b1111_11n), 0b1111_11n);
  assertStrictEquals(testXOr(0b1111_11n, 0b0000_00n), 0b1111_11n);

  assertStrictEquals(testXOr(0b1000_00n, 0b1000_00n), 0b0000_00n);
  assertStrictEquals(testXOr(0b0000_01n, 0b1000_00n), 0b1000_01n);
  assertStrictEquals(testXOr(0b1000_00n, 0b0000_01n), 0b1000_01n);
  assertStrictEquals(testXOr(0b0000_01n, 0b0000_01n), 0b0000_00n);

  assertStrictEquals(testXOr(0b0000_000n, 0b0000_000n), 0b0000_000n);
  assertStrictEquals(testXOr(0b1111_111n, 0b1111_111n), 0b0000_000n);
  assertStrictEquals(testXOr(0b0000_000n, 0b1111_111n), 0b1111_111n);
  assertStrictEquals(testXOr(0b1111_111n, 0b0000_000n), 0b1111_111n);

  assertStrictEquals(testXOr(0b1000_000n, 0b1000_000n), 0b0000_000n);
  assertStrictEquals(testXOr(0b0000_001n, 0b1000_000n), 0b1000_001n);
  assertStrictEquals(testXOr(0b1000_000n, 0b0000_001n), 0b1000_001n);
  assertStrictEquals(testXOr(0b0000_001n, 0b0000_001n), 0b0000_000n);

  assertStrictEquals(testXOr(0b0000_0000n, 0b0000_0000n), 0b0000_0000n);
  assertStrictEquals(testXOr(0b1111_1111n, 0b1111_1111n), 0b0000_0000n);
  assertStrictEquals(testXOr(0b0000_0000n, 0b1111_1111n), 0b1111_1111n);
  assertStrictEquals(testXOr(0b1111_1111n, 0b0000_0000n), 0b1111_1111n);

  assertStrictEquals(testXOr(0b1000_0000n, 0b1000_0000n), 0b0000_0000n);
  assertStrictEquals(testXOr(0b0000_0001n, 0b1000_0000n), 0b1000_0001n);
  assertStrictEquals(testXOr(0b1000_0000n, 0b0000_0001n), 0b1000_0001n);
  assertStrictEquals(testXOr(0b0000_0001n, 0b0000_0001n), 0b0000_0000n);

  assertStrictEquals(
    testXOr(0b0000_0000_0000_0000n, 0b0000_0000_0000_0000n),
    0b0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(0b1111_1111_1111_1111n, 0b1111_1111_1111_1111n),
    0b0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(0b0000_0000_0000_0000n, 0b1111_1111_1111_1111n),
    0b1111_1111_1111_1111n,
  );
  assertStrictEquals(
    testXOr(0b1111_1111_1111_1111n, 0b0000_0000_0000_0000n),
    0b1111_1111_1111_1111n,
  );

  assertStrictEquals(
    testXOr(0b1000_0000_0000_0000n, 0b1000_0000_0000_0000n),
    0b0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(0b0000_0000_0000_0001n, 0b1000_0000_0000_0000n),
    0b1000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(0b1000_0000_0000_0000n, 0b0000_0000_0000_0001n),
    0b1000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(0b0000_0000_0000_0001n, 0b0000_0000_0000_0001n),
    0b0000_0000_0000_0000n,
  );

  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000n,
      0b0000_0000_0000_0000_0000_0000n,
    ),
    0b0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b1111_1111_1111_1111_1111_1111n,
      0b1111_1111_1111_1111_1111_1111n,
    ),
    0b0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000n,
      0b1111_1111_1111_1111_1111_1111n,
    ),
    0b1111_1111_1111_1111_1111_1111n,
  );
  assertStrictEquals(
    testXOr(
      0b1111_1111_1111_1111_1111_1111n,
      0b0000_0000_0000_0000_0000_0000n,
    ),
    0b1111_1111_1111_1111_1111_1111n,
  );

  assertStrictEquals(
    testXOr(
      0b1000_0000_0000_0000_0000_0000n,
      0b1000_0000_0000_0000_0000_0000n,
    ),
    0b0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0001n,
      0b1000_0000_0000_0000_0000_0000n,
    ),
    0b1000_0000_0000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(
      0b1000_0000_0000_0000_0000_0000n,
      0b0000_0000_0000_0000_0000_0001n,
    ),
    0b1000_0000_0000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0001n,
      0b0000_0000_0000_0000_0000_0001n,
    ),
    0b0000_0000_0000_0000_0000_0000n,
  );

  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0000n,
      0b0000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b1111_1111_1111_1111_1111_1111_1111_1111n,
      0b1111_1111_1111_1111_1111_1111_1111_1111n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0000n,
      0b1111_1111_1111_1111_1111_1111_1111_1111n,
    ),
    0b1111_1111_1111_1111_1111_1111_1111_1111n,
  );
  assertStrictEquals(
    testXOr(
      0b1111_1111_1111_1111_1111_1111_1111_1111n,
      0b0000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b1111_1111_1111_1111_1111_1111_1111_1111n,
  );

  assertStrictEquals(
    testXOr(
      0b1000_0000_0000_0000_0000_0000_0000_0000n,
      0b1000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0001n,
      0b1000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b1000_0000_0000_0000_0000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(
      0b1000_0000_0000_0000_0000_0000_0000_0000n,
      0b0000_0000_0000_0000_0000_0000_0000_0001n,
    ),
    0b1000_0000_0000_0000_0000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0001n,
      0b0000_0000_0000_0000_0000_0000_0000_0001n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000n,
  );

  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111n,
      0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
      0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111n,
    ),
    0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111n,
  );
  assertStrictEquals(
    testXOr(
      0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111n,
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111n,
  );

  assertStrictEquals(
    testXOr(
      0b1000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
      0b1000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0001n,
      0b1000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
    ),
    0b1000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(
      0b1000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0001n,
    ),
    0b1000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0001n,
  );
  assertStrictEquals(
    testXOr(
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0001n,
      0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0001n,
    ),
    0b0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000n,
  );

  assertStrictEquals(
    testXOr(
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
    ),
    0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
  );
  assertStrictEquals(
    testXOr(
      0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111n,
      0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111n,
    ),
    0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
  );
  assertStrictEquals(
    testXOr(
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
      0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111n,
    ),
    0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111n,
  );
  assertStrictEquals(
    testXOr(
      0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111n,
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
    ),
    0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111n,
  );

  assertStrictEquals(
    testXOr(
      0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
      0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
    ),
    0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
  );
  assertStrictEquals(
    testXOr(
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000001n,
      0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
    ),
    0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000001n,
  );
  assertStrictEquals(
    testXOr(
      0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000001n,
    ),
    0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000001n,
  );
  assertStrictEquals(
    testXOr(
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000001n,
      0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000001n,
    ),
    0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000n,
  );
});

Deno.test("Numerics.BigUint64.bitwiseXOr() - error", () => {
  assertThrows(
    () => {
      testXOr(-1n, 0n);
    },
    TypeError,
    "Input must be a 64-bit unsigned integer of type `bigint`",
  );
  assertThrows(
    () => {
      testXOr(0n, -1n);
    },
    TypeError,
    "Input must be a 64-bit unsigned integer of type `bigint`",
  );

  assertThrows(
    () => {
      testXOr(0x10000000000000000n, 0n);
    },
    TypeError,
    "Input must be a 64-bit unsigned integer of type `bigint`",
  );
  assertThrows(
    () => {
      testXOr(0n, 0x10000000000000000n);
    },
    TypeError,
    "Input must be a 64-bit unsigned integer of type `bigint`",
  );
});
